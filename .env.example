TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SeAdmitenHumanosBot
PORT=8080
# Use false only for local HTTP preview. Railway must keep the secure default.
WEB_COOKIE_SECURE=true
# Legacy first-user bootstrap only. New users will be linked in the database.
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=
DATABASE_PATH=rentals.sqlite3
POLL_INTERVAL_SECONDS=180
MAX_LISTINGS_PER_RUN=50
MAX_CONSECUTIVE_FAILURES=3
# Required only when starting with an empty hosted database. Use minified JSON.
PROFILE_BUNDLE_JSON=
IDEALISTA_API_KEY=
IDEALISTA_API_SECRET=
OUTREACH_MODE=draft
OUTREACH_FROM_NAME=
RENTER_NAME=
RENTER_MONTHLY_INCOME=
RENTER_JOB=
RENTER_PETS=
AUTO_EMAIL_DOMAIN_ALLOWLIST=
