TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SeAdmitenHumanosBot
PORT=8080
# Use false only for local HTTP preview. Railway must keep the secure default.
WEB_COOKIE_SECURE=true
# Enable only after configuring and testing transactional email.
ACCOUNTS_ENABLED=false
PUBLIC_BASE_URL=
# Preferred on Railway Free, Trial and Hobby plans because SMTP ports are blocked.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# false = mandatory STARTTLS; true = implicit TLS (normally port 465).
SMTP_IMPLICIT_TLS=false
# Legacy first-user bootstrap only. New users will be linked in the database.
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=
DATABASE_PATH=rentals.sqlite3
POLL_INTERVAL_SECONDS=180
MAX_LISTINGS_PER_RUN=50
MAX_CONSECUTIVE_FAILURES=3
# Required only when starting with an empty hosted database. Use minified JSON.
PROFILE_BUNDLE_JSON=
IDEALISTA_API_KEY=
IDEALISTA_API_SECRET=
# Enables Brevo inbound parsing at POST /webhooks/brevo/idealista.
# Generate at least 32 random characters and configure it as Brevo bearer auth.
IDEALISTA_EMAIL_WEBHOOK_TOKEN=
# Optional official-API tuning. Defaults: Madrid center, 20 km, 15 minutes, today, 1 page.
IDEALISTA_CENTER=40.4168,-3.7038
IDEALISTA_DISTANCE_METERS=20000
IDEALISTA_POLL_INTERVAL_SECONDS=900
IDEALISTA_SINCE_DATE=T
IDEALISTA_MAX_PAGES=1
OUTREACH_MODE=draft
OUTREACH_FROM_NAME=
RENTER_NAME=
RENTER_MONTHLY_INCOME=
RENTER_JOB=
RENTER_PETS=
AUTO_EMAIL_DOMAIN_ALLOWLIST=
